# RootSight Environment Configuration
# Optional LLM Configuration (RootSight operates fully deterministically without an LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anomaly Detection Settings
MAD_THRESHOLD=3.0
Z_SCORE_THRESHOLD=3.0
MIN_HISTORY_OBSERVATIONS=5

# Ranking Engine Weights (Method A: Explainable Baseline)
WEIGHT_ANOMALY=0.35
WEIGHT_DEPENDENCY=0.30
WEIGHT_TRACE=0.20
WEIGHT_LOG=0.15
